  "projectName": "AgentSwarm",
  "projectDescription": "AgentSwarm is a Docker-based web app for running and managing AI coding agents (Codex and Claude) against real Git repositories, with full task orchestration, diff review, and GitHub integration.",
  "theme": "luma",
  "primaryColor": "#6366f1",
